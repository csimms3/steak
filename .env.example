DATABASE_URL="postgresql://steak:steak@localhost:5432/steak?schema=public"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3001"

# Reverse proxies in front of the app that append to X-Forwarded-For (1 on
# Heroku/Vercel). Unset/0 = don't trust forwarding headers; auth rate limits
# then apply to all clients as one bucket.
TRUSTED_PROXY_HOPS="0"
