generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  player
  admin
}

enum GameType {
  dice
  limbo
  wheel
  flip
  keno
  diamonds
  plinko
  mines
  hilo
  dragon_tower
  blackjack
  video_poker
  crash
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  balance      BigInt        @default(100000)
  role         Role          @default(player)
  createdAt    DateTime      @default(now())
  gameSessions GameSession[]
  gameRounds   GameRound[]
}

// One row per resolved bet — stateless games write this immediately;
// stateful games write it once, at the terminal event (loss or cashout).
model GameSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  game           GameType
  betAmount      BigInt
  profit         BigInt
  multiplier     Float
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  outcome        Json
  createdAt      DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// Server-side storage for an in-progress stateful game's secret data
// (mine positions, dragon positions, dealt cards, deck order, etc).
// Authenticated play uses this instead of the client-visible base64 blob,
// so secrets can't be read or tampered with client-side. Row is deleted
// on terminal resolution (loss or cashout) — no TTL needed.
model GameRound {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  game      GameType
  betAmount BigInt
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

// Single-row settings table — always id = 1
model Settings {
  id                     Int      @id @default(1)
  defaultStartingBalance BigInt   @default(100000)
  updatedAt              DateTime @updatedAt
}
